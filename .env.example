# Database Configuration (Centralized PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key

# Redis Configuration (Distributed Lock & Queue)
REDIS_URL=redis://localhost:6379/0

# Worker Identification (Contoh: macbook-pro-local atau vps-cloud-worker-1)
WORKER_ID=local-worker

# Queue & Locking Tuning
TASK_QUEUE_NAME=agent:task:queue
EVENT_CHANNEL=agent:events
LOCK_TTL_SECONDS=600

# Dashboard Access & Task Dispatch Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password
AUTH_SECRET_KEY=your-jwt-auth-secret-key-32-chars

# 9Router Smart Gateway (PRIMARY / DEFAULT: http://localhost:20128/v1)
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_API_KEY=your-9router-api-key
NINE_ROUTER_MODEL=gpt-4o-mini

# Direct Fallback Provider (Opsional jika 9Router down)
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEFAULT_LLM_MODEL=gpt-4o-mini
GEMINI_API_KEY=

# Article Publisher Settings (Opsional)
API_ENDPOINT=
SECRET_KEY=
USER_ID=
PEXELS_KEY=

# YouTube & Dongeng Pipeline Settings (Opsional)
YOUTUBE_API_KEY=
DONGENG_CMS_POST_URL=
DONGENG_CMS_SEARCH_URL=
DONGENG_TARGET_CHANNELS=[]
DONGENG_FONT_PATH=/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf
